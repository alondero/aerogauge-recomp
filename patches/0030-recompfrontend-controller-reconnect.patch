+
+void players::add_controller(SDL_GameController* controller) {
+    // An ADDED event can precede the old handle's deferred removal. Exclude
+    // detached handles before checking for simultaneous duplicate identities.
+    std::unordered_set<int32_t> attached;
+    for (int index = 0; index < SDL_NumJoysticks(); ++index) {
+        const auto id = SDL_JoystickGetDeviceInstanceID(index);
+        auto* pad = SDL_GameControllerFromInstanceID(id);
+        if (pad != nullptr && SDL_GameControllerGetAttached(pad)) attached.insert(id);
+    }
+    // Detached devices no longer appear in SDL enumeration. Their cached IDs
+    // must be removed before registering a returning device's serial.
+    controller_identities.retain_connected(attached);
+    const char* serial = SDL_GameControllerGetSerial(controller);
+    char model[33];
+    SDL_JoystickGetGUIDString(SDL_JoystickGetGUID(SDL_GameControllerGetJoystick(controller)), model, sizeof(model));
+    controller_identities.connect(SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller)),
+        model, serial ? serial : "");
+}
+
+void players::restore_controllers() {
+    // Manual assignment takes priority; cancellation leaves reservations intact.
+    if (PlayerState.is_assigning) return;
+    bool changed = false;
+    for (size_t slot = 0; slot < PlayerState.max_players; ++slot) {
+        auto& player = PlayerState.players[slot];
+        auto& reservation = PlayerState.reservations[slot];
+        if (!reservation.disconnected || player.controller != nullptr || player.keyboard_enabled) continue;
+        const auto id = controller_identities.find(reservation.identity);
+        if (id < 0) continue;
+        auto* controller = recompinput::get_controller_from_joystick_id(id);
+        if (controller == nullptr || !SDL_GameControllerGetAttached(controller)) continue;
+        bool already_assigned = false;
+        for (const auto& other : PlayerState.players)
+            if (other.controller == controller) already_assigned = true;
+        if (already_assigned) continue;
+        player.controller = controller;
+        player.controller_id = id;
+        reservation.disconnected = false;
+        changed = true;
+        // The slot's profile selection survives; no new assignment or compaction.
+    }
+    if (changed && recompui::controls_page != nullptr) recompui::controls_page->force_update();
+}
