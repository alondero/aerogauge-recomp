diff --git a/recompinput/include/recompinput/controller_identity.h b/recompinput/include/recompinput/controller_identity.h
new file mode 100644
index 0000000..a859c24
--- /dev/null
+++ b/recompinput/include/recompinput/controller_identity.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace recompinput {
+
+// Process-local physical identities. Model/GUID, device paths, player indices,
+// and SDL instance IDs alone cannot identify a physical controller on reconnect.
+// Keep duplicate serials ambiguous for the rest of the process, even after one
+// device leaves; otherwise the remaining identical unit could steal its slot.
+class ControllerIdentityMap {
+    std::unordered_map<int32_t, std::string> connected;
+    std::unordered_set<std::string> ambiguous;
+
+public:
+    void connect(int32_t id, const std::string& model, const std::string& serial) {
+        disconnect(id);
+        if (serial.empty()) return;
+        const std::string key = std::to_string(model.size()) + ":" + model + serial;
+        for (const auto& [other_id, identity] : connected) {
+            if (identity == key) ambiguous.insert(key);
+        }
+        connected[id] = key;
+    }
+
+    void disconnect(int32_t id) { connected.erase(id); }
+
+    void retain_connected(const std::unordered_set<int32_t>& ids) {
+        for (auto it = connected.begin(); it != connected.end();) {
+            if (!ids.contains(it->first)) it = connected.erase(it);
+            else ++it;
+        }
+    }
+
+    std::string identity_for(int32_t id) const {
+        auto it = connected.find(id);
+        if (it == connected.end() || ambiguous.contains(it->second)) return {};
+        return it->second;
+    }
+
+    int32_t find(const std::string& identity) const {
+        if (identity.empty() || ambiguous.contains(identity)) return -1;
+        for (const auto& [id, candidate] : connected) {
+            if (candidate == identity) return id;
+        }
+        return -1;
+    }
+};
+
+}
