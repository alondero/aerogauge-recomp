+void recompinput::collect_detached_controller_states(std::vector<SDL_GameController*>& controllers) {
+    std::lock_guard lock{ InputState.controllers_mutex };
+    for (auto it = InputState.controller_states.begin(); it != InputState.controller_states.end();) {
+        SDL_GameController* controller = it->second.controller;
+        if (controller != nullptr && !SDL_GameControllerGetAttached(controller)) {
+            controllers.push_back(controller);
+            it = InputState.controller_states.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void recompinput::collect_all_controller_states(std::vector<SDL_GameController*>& controllers) {
+    std::lock_guard lock{ InputState.controllers_mutex };
+    for (const auto& [joystick_id, state] : InputState.controller_states) {
+        (void)joystick_id;
+        if (state.controller != nullptr) {
+            controllers.push_back(state.controller);
+        }
+    }
+    InputState.controller_states.clear();
+}
