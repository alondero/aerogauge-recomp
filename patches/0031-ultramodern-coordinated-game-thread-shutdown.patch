index 0000000..d39b06a
--- /dev/null
+++ b/ultramodern/include/ultramodern/shutdown.hpp
@@ -0,0 +1,68 @@
+#ifndef __ultramodern_SHUTDOWN_HPP__
+#define __ultramodern_SHUTDOWN_HPP__
+
+#include <chrono>
+
+// Coordinated shutdown contract for the guest (game) threads.
+//
+// The port owns the process; the runtime owns the guest threads. Shutdown is a
+// handshake between the two, and it runs in four phases:
+//
+//   1. request()      Stop new work. The shutdown flag is published and every
+//                     registered guest thread is released so it can observe the
+//                     flag and unwind out of its translated entry point.
+//   2. (guest)        Outstanding guest work is cancelled. A guest thread that
+//                     is already running keeps running translated code until
+//                     its next blocking point, where it observes the flag and
+//                     unwinds.
+//   3. join_threads() Wait for the guest threads to finish unwinding.
+//   4. (owner)        The owner may now release RDRAM and the device resources.
+//
+// Ordering rule: the owner must not release RDRAM, the renderer, or the audio
+// device until join_threads() reports zero remaining threads. A guest thread
+// that is still running may still be executing translated code, and translated
+// code reads and writes RDRAM.
+//
+// The contract is deliberately independent of the port: the runtime never
+// decides how long a shutdown may take. The owner passes a deadline to
+// join_threads() and decides what to do when it expires.
+namespace ultramodern::shutdown {
+
+// Releases a guest thread that is blocked so that it can observe the shutdown
+// flag. The callback must not block: it runs on the thread that calls
+// request().
+using WakeCallback = void (*)(void* token);
+
+// Registers a guest thread with the shutdown coordinator.
+//
+// A thread must be registered before it can block and unregistered once it has
+// finished touching guest memory. Registering a thread after request() has
+// been called releases it immediately: a shutdown admits no new guest work.
+void register_thread(void* token, WakeCallback wake);
+
+// Unregisters a guest thread. The token must be the one passed to
+// register_thread().
+void unregister_thread(void* token);
+
+// Phase 1. Idempotent and safe to call from any thread.
+void request();
+
+// True once request() has been called.
+bool requested();
+
+// Number of registered guest threads that have not been unregistered yet.
+int pending_threads();
+
+// Phase 3. Waits up to `timeout` for every registered guest thread to
+// unregister itself.
+//
+// Returns the number of threads that were still pending when the wait ended.
+// Zero means every guest thread finished and the owner may release RDRAM and
+// the device resources. A non-zero result means guest threads are still
+// running, so the owner must not release those resources and must use a
+// bounded exit instead.
+int join_threads(std::chrono::milliseconds timeout);
+
+}
+
+#endif
