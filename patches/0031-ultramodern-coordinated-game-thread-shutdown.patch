diff --git a/ultramodern/src/shutdown.cpp b/ultramodern/src/shutdown.cpp
new file mode 100644
index 0000000..4756e47
--- /dev/null
+++ b/ultramodern/src/shutdown.cpp
@@ -0,0 +1,92 @@
+#include "ultramodern/shutdown.hpp"
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <unordered_map>
+
+// The coordinator is deliberately free of runtime internals: it owns the
+// shutdown flag, the registry of live guest threads, and the join. The runtime
+// supplies a wake callback per thread, because only the runtime knows how a
+// guest thread is parked (scheduler semaphore, external message queue, ...).
+namespace {
+
+std::atomic<bool> g_requested{false};
+
+std::mutex g_mutex;
+std::condition_variable g_changed;
+// Guest thread token -> the callback that releases it.
+std::unordered_map<void*, ultramodern::shutdown::WakeCallback> g_wakes;
+// Number of registered guest threads that have not unregistered yet.
+int g_pending = 0;
+
+}
+
+void ultramodern::shutdown::register_thread(void* token, WakeCallback wake) {
+    bool release_now = false;
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        auto it = g_wakes.find(token);
+        if (it != g_wakes.end()) {
+            // Already registered: the thread is counted once and has already
+            // been released if a shutdown was requested.
+            return;
+        }
+        g_wakes.emplace(token, wake);
+        g_pending++;
+        // A thread that is created after the shutdown request must not start
+        // new guest work: release it right away so it observes the flag.
+        release_now = g_requested.load(std::memory_order_acquire);
+    }
+    if (release_now && wake != nullptr) {
+        wake(token);
+    }
+}
+
+void ultramodern::shutdown::unregister_thread(void* token) {
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        auto it = g_wakes.find(token);
+        if (it == g_wakes.end()) {
+            // Unknown token: the thread was never registered (or is already
+            // gone). The pending count must not change.
+            return;
+        }
+        g_wakes.erase(it);
+        g_pending--;
+    }
+    g_changed.notify_all();
+}
+
+void ultramodern::shutdown::request() {
+    // Publish the flag before releasing anybody: a released thread must never
+    // observe the flag late.
+    if (g_requested.exchange(true, std::memory_order_acq_rel)) {
+        return;
+    }
+
+    // The wake callbacks run under the coordinator's lock. A context stays
+    // alive for as long as it is registered, and unregistering needs the same
+    // lock, so a callback can never run against a freed thread context.
+    std::lock_guard<std::mutex> lock(g_mutex);
+    for (const auto& entry : g_wakes) {
+        if (entry.second != nullptr) {
+            entry.second(entry.first);
+        }
+    }
+}
+
+bool ultramodern::shutdown::requested() {
+    return g_requested.load(std::memory_order_acquire);
+}
+
+int ultramodern::shutdown::pending_threads() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_pending;
+}
+
+int ultramodern::shutdown::join_threads(std::chrono::milliseconds timeout) {
+    std::unique_lock<std::mutex> lock(g_mutex);
+    g_changed.wait_for(lock, timeout, [] { return g_pending == 0; });
+    return g_pending;
+}
