From: AeroGauge Contributors <noreply@example.com>
Subject: [PATCH] recompinput: close duplicate handle on SDL_CONTROLLERDEVICEADDED

During startup, SDL2-compat / SDL3 can emit SDL_CONTROLLERDEVICEADDED for a
hotplug concurrently with the host's startup controller enumeration. Checking
the opened controller's joystick instance ID against
recompinput::get_controller_from_joystick_id and closing the extra reference
prevents retaining a second handle even if device indices shift between calls.

diff --git a/recompinput/src/input_events.cpp b/recompinput/src/input_events.cpp
index d839d12..1000001 100644
--- a/recompinput/src/input_events.cpp
+++ b/recompinput/src/input_events.cpp
@@ -76,9 +76,14 @@ bool sdl_event_filter(void* userdata, SDL_Event* event) {
         SDL_GameController* controller = SDL_GameControllerOpen(controller_event->which);
         printf("Controller added: %d\n", controller_event->which);
         if (controller != nullptr) {
-            printf("  Instance ID: %d\n", SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller)));
+            const SDL_JoystickID instance_id = SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller));
+            if (recompinput::get_controller_from_joystick_id(instance_id) != nullptr) {
+                SDL_GameControllerClose(controller);
+                break;
+            }
+            printf("  Instance ID: %d\n", instance_id);
             printf("  Path: %s\n", SDL_JoystickPath(SDL_GameControllerGetJoystick(controller)));
-            recompinput::add_controller_state(SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controller)), controller);
+            recompinput::add_controller_state(instance_id, controller);
 
             if (SDL_GameControllerHasSensor(controller, SDL_SensorType::SDL_SENSOR_GYRO) && SDL_GameControllerHasSensor(controller, SDL_SensorType::SDL_SENSOR_ACCEL)) {
                 SDL_GameControllerSetSensorEnabled(controller, SDL_SensorType::SDL_SENSOR_GYRO, SDL_TRUE);
