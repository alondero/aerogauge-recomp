+// The port normally uses _Exit rather than runtime teardown. A barrier keeps
+// acknowledged EEPROM writes from being lost when the window closes.
+static std::mutex flush_mutex;
+static std::condition_variable flush_complete;
+static bool saving_ready = false;
+static uint64_t flush_requested = 0, flushed = 0;
+
+extern "C" void aero_flush_eeprom() {
+    std::unique_lock lock(flush_mutex);
+    if (!saving_ready) return;
+    const uint64_t request = ++flush_requested;
+    flush_complete.wait(lock, [request] { return !saving_ready || flushed >= request; });
+}
