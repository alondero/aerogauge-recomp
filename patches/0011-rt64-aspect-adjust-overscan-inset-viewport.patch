+    // True if `rect` covers the full width of `fbRect`, allowing a small SYMMETRIC inset
+    // border. Games commonly render the 3D scene inside an overscan border instead of
+    // touching the framebuffer edges (e.g. AeroGauge draws at x 16..303 of a 320-wide
+    // framebuffer); requiring exact edge-to-edge coverage made the automatic aspect
+    // ratio widening reject such scenes entirely. The border allowance is 1/8th of the
+    // framebuffer width per side with at most 1/32nd asymmetry, so split-screen
+    // sub-viewports (half/quarter width, or flush to one side) are never widened.
+    inline bool coversWidthWithOverscan(const FixedRect &rect, const FixedRect &fbRect) {
+        if (rect.ulx >= rect.lrx) {
+            return false;
+        }
+        const int32_t leftBorder = rect.ulx - fbRect.ulx;
+        const int32_t rightBorder = fbRect.lrx - rect.lrx;
+        if ((leftBorder <= 0) && (rightBorder <= 0)) {
+            return true;
+        }
+        if ((leftBorder < 0) || (rightBorder < 0)) {
+            return false;
+        }
+        const int32_t fbWidth = fbRect.lrx - fbRect.ulx;
+        const int32_t maxBorder = fbWidth / 8;
+        const int32_t asymmetry = (leftBorder > rightBorder) ? (leftBorder - rightBorder) : (rightBorder - leftBorder);
+        return (leftBorder <= maxBorder) && (rightBorder <= maxBorder) && (asymmetry <= fbWidth / 32);
+    }
