index 277a421..c50d342 100644
--- a/recompui/src/base/ui_state.cpp
+++ b/recompui/src/base/ui_state.cpp
@@ -42,7 +42,9 @@ void recompui::open_quit_game_prompt() {
         "Quit",
         "Cancel",
         []() {
-            ultramodern::quit();
+            SDL_Event event{};
+            event.type = SDL_QUIT;
+            SDL_PushEvent(&event);
         },
         []() {},
         recompui::ButtonStyle::Danger,
@@ -803,7 +805,16 @@ void draw_hook(plume::RenderCommandList* command_list, plume::RenderFramebuffer*
             }
             else {
                 if (context_capturing_input) {
-                    RmlSDL::InputEventHandler(ui_state->context, cur_event);
+                    // Hosts may synthesize the frontend's F16/F17 tab actions.
+                    // The SDL backend only translates through F15.
+                    if ((cur_event.type == SDL_KEYDOWN || cur_event.type == SDL_KEYUP) &&
+                        (cur_event.key.keysym.sym == SDLK_F16 || cur_event.key.keysym.sym == SDLK_F17)) {
+                        const auto key = convert_sdl_to_rml(cur_event.key.keysym.sym);
+                        if (cur_event.type == SDL_KEYDOWN) ui_state->context->ProcessKeyDown(key, 0);
+                        else ui_state->context->ProcessKeyUp(key, 0);
+                    } else {
+                        RmlSDL::InputEventHandler(ui_state->context, cur_event);
+                    }
                 }
             }
         }
