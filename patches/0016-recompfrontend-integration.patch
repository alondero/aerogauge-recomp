+// ConfigOptionEnumCycler
+ConfigOptionEnumCycler::ConfigOptionEnumCycler(
+    ResourceId rid,
+    Element *parent,
+    std::string option_id,
+    size_t option_index,
+    const recomp::config::Config *config,
+    set_option_value_t set_option_value,
+    on_option_hover_t on_hover
+) : ConfigOptionElement(rid, parent, option_id, option_index, config, set_option_value, on_hover,
+                        Events(EventType::Hover, EventType::Focus, EventType::Navigate))
+{
+    ContextId context = recompui::get_current_context();
+    Element *wrapper = context.create_element<Element>(this, 0, "div", false);
+    wrapper->set_display(Display::Flex);
+    wrapper->set_flex_direction(FlexDirection::Row);
+    wrapper->set_align_items(AlignItems::Center);
+    wrapper->set_justify_content(JustifyContent::FlexStart);
+    wrapper->set_width(100.0f, Unit::Percent);
+    wrapper->set_gap(12.0f);
+
+    // Negates the extra padding that radio tabs automatically add.
+    name_label->set_margin_bottom(4.0f);
+
+    // Consume left/right on the cycler itself so navigating rotates the value
+    // instead of moving focus to a sibling option.
+    enable_focus();
+    set_nav_none(NavDirection::Left);
+    set_nav_none(NavDirection::Right);
+
+    prev_button = context.create_element<IconButton>(wrapper, "icons/ArrowLeft.svg",
+                                                     ButtonStyle::Secondary, IconButtonSize::Small);
+    prev_button->add_pressed_callback([this]() { cycle(-1); });
+
+    value_label = context.create_element<Label>(wrapper, "", theme::Typography::LabelMD);
+    value_label->set_min_width(200.0f);
+    value_label->set_max_width(200.0f);
+    value_label->set_text_align(TextAlign::Center);
+
+    next_button = context.create_element<IconButton>(wrapper, "icons/Arrow.svg",
+                                                     ButtonStyle::Secondary, IconButtonSize::Small);
+    next_button->add_pressed_callback([this]() { cycle(1); });
+
+    details_label = context.create_element<Label>(wrapper, "", theme::Typography::LabelXS);
+    details_label->set_color(theme::color::Primary);
+
+    update_value();
+    update_enum_details();
+    update_disabled();
+};
+
+void ConfigOptionEnumCycler::update_value() {
+    recomp::config::ConfigValueVariant value_variant = get_value();
+    uint32_t option_value = std::get<uint32_t>(value_variant);
+
+    auto &enum_opt = config->get_option_config<recomp::config::ConfigOptionEnum>(this->option_index);
+    for (uint32_t i = 0; i < enum_opt.options.size(); i++) {
+        if (enum_opt.options[i].value == option_value) {
+            value_label->set_text(enum_opt.options[i].name);
+            return;
+        }
+    }
+    value_label->set_text("");
+};
+
+void ConfigOptionEnumCycler::update_disabled() {
+    bool disabled = get_disabled();
+    set_enabled(!disabled);
+    prev_button->set_enabled(!disabled);
+    next_button->set_enabled(!disabled);
+};
+
+void ConfigOptionEnumCycler::update_enum_details() {
+    const std::string &enum_details = config->get_enum_option_details(option_index);
+    details_label->set_text(enum_details);
+};
+
+void ConfigOptionEnumCycler::process_event(const Event &e) {
+    switch (e.type) {
+    case EventType::Update:
+        // This element renders selected state purely from config state (no
+        // self-repainting widget underneath), so Value updates queued by the
+        // options page must re-run update_value().
+        update_value();
+        break;
+    case EventType::Navigate:
+        {
+            NavDirection dir = std::get<EventNavigate>(e.variant).direction;
+            if (dir == NavDirection::Left) {
+                cycle(-1);
+            }
+            else if (dir == NavDirection::Right) {
+                cycle(1);
+            }
+        }
+        break;
+    default:
+        ConfigOptionElement::process_event(e);
+        break;
+    }
+}
+
+void ConfigOptionEnumCycler::cycle(int direction) {
+    if (!is_enabled()) {
+        return;
+    }
+
+    auto &enum_opt = config->get_option_config<recomp::config::ConfigOptionEnum>(this->option_index);
+    const size_t count = enum_opt.options.size();
+    if (count == 0) {
+        return;
+    }
+
+    uint32_t option_value = std::get<uint32_t>(get_value());
+    size_t current = count;
+    for (size_t i = 0; i < count; i++) {
+        if (enum_opt.options[i].value == option_value) {
+            current = i;
+            break;
+        }
+    }
+    // Off-schema values (e.g. a stale json) snap to the first option.
+    if (current == count) {
+        current = 0;
+    }
+
+    size_t next = current;
+    for (size_t steps = 0; steps < count; steps++) {
+        next = (next + count + direction) % count;
+        if (!config->get_enum_option_disabled(option_index, uint32_t(next))) {
+            break;
+        }
+        // Else keep rotating past a disabled option.
+    }
+
+    set_option_value(this->option_id, enum_opt.options[next].value);
+}
