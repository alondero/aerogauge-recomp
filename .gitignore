# --- Copyrighted game data (NEVER commit) ---------------------------------
# The original ROM must be supplied by the user. This project ships no assets.
*.z64
*.n64
*.v64
*.rom
# Per-session EEPROM save (4Kbit/512 B) written by main.cpp's recomp::SaveType::Eep4k
# path to the repo root when the user hasn't set the librecomp save folder. Strip
# from the index if it sneaks in: `git rm --cached "*.eeprom"`.
*.eeprom

# --- Recompiler output (regenerated from your ROM at build time) -----------
# `scripts/gen_syms_toml.py` + the N64Recomp CLI produce these from the ROM.
RecompiledFuncs/
data_dump.toml
# RSP audio microcode, RSPRecomp'd from your ROM (BUILDING.md step 3):
src/aspMain.cpp

# --- CMake build trees -----------------------------------------------------
build/
build-*/
out/
CMakeUserPresets.json
compile_commands.json

# --- Editor / OS -----------------------------------------------------------
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Bundled emulator + debug captures (not source; regenerable/large) ------
# ares reference emulator for live-debug skills (ares-debugger / port-vs-ares-harness)
tools/emulators/
# ares↔port live-debug harness (Python GDB client; copied from
# automobililamborghini-recomp on demand). Land as its own PR when first user
# needs it — see issue #7's "Tooling" note.
tools/emu_instrumentation/
# RDRAM / framebuffer / DL dumps captured from ares or the port
*.bin
dma_validation/

# --- Logs / scratch --------------------------------------------------------
*.log
*.stackdump
# gdb batch backtrace/logging dumps from native port debugging
gdb_bt*.txt
# root-level display-list capture dumps (e.g. hud-pre.txt / hud-post.txt from AERO_RACE_DL_DUMP)
/hud-*.txt
# framebuffer / display-list render captures from the port
*.bmp
# Python bytecode cache (scripts/gen_syms_toml.py etc.)
__pycache__/

# --- Local AI Artefacts ----------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
# local live-debug harnesses (HUD attribution etc.); not product source
.claude/*.gdb
CLAUDE.local.md
nextsessionprompt.md
.worktreeinclude

